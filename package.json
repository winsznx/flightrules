{
  "name": "flightrules",
  "version": "0.1.0",
  "private": true,
  "description": "FlightRules turns SigNoz traces into deterministic release contracts that catch skipped checks, duplicate side effects, unknown tool paths, and behavioural drift before an agent canary reaches production.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --build --force tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration-db --project integration-signoz",
    "build": "pnpm -r --if-present run build",
    "scan:secrets": "secretlint --secretlintignore .gitignore \"**/*\"",
    "scan:licences": "node scripts/check-licences.mjs",
    "scan:deps": "pnpm audit --audit-level high",
    "test:integration:db": "vitest run --project integration-db",
    "test:integration:signoz": "vitest run --project integration-signoz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "24.13.3",
    "secretlint": "13.0.4",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
